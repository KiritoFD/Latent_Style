    "preload_to_gpu": false,
    "virtual_length_multiplier": 0.02
  },
  "checkpoint": {
    "save_dir": "./exp/wikiart512_ema_direct_atom_residual_calib_b16"
  },
  "ablation": {
    "name": "wikiart512_ema_direct_atom_residual_calib_b16",
    "axis": "wikiart512_tokenizer_lancet",
    "notes": "512-native EMA WikiArt latent calibration: 5 styles, 3600 train + 30 held-out test per style."
  }
}
