    "tokenizer_num_atoms": 32,
    "tokenizer_atom_temperature": 0.25,
    "tokenizer_init_std": 0.2
  },
  "training": {
    "batch_size": 16,
    "learning_rate": 0.0002,
    "num_epochs": 1,
    "save_interval": 1,
    "resume_checkpoint": "",
    "resume_model_strict": false,
    "resume_include_prefixes": [],
    "resume_ignore_prefixes": [],
    "resume_training_state": false,
    "resume_optimizer": false,
    "freeze_mode": "none",
    "freeze_reinit_trainable": false,
    "num_workers": 0,
    "use_amp": true,
    "amp_dtype": "bf16",
    "channels_last": true,
    "use_gradient_checkpointing": true,
    "numeric_debug": true,
    "numeric_debug_interval": 20,
    "full_eval_batch_size": 1
