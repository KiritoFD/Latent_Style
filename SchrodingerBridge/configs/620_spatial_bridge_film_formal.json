{
  "_base": "620_spatial_bridge_targetlinear.json",
  "model": {
    "endpoint_film_enabled": true,
    "endpoint_head_mode": "endpoint_lowhigh"
  },
  "training": {
    "batch_size": 64,
    "num_epochs": 8,
    "full_eval_each_epoch": true,
    "full_eval_defer_until_training_end": false
  },
  "full_eval": {
    "save_generated_images": true,
    "only_lpips_clip_style": false
  },
  "checkpoint": {
    "save_dir": "./exp/620_spatial_bridge/620_film_formal"
  },
  "ablation": {
    "name": "620_film_formal",
    "axis": "620_endpoint_head_style",
    "stage": "formal",
    "notes": "H4 FiLM endpoint heads formal run: 8 epochs with full eval each epoch"
  }
}
